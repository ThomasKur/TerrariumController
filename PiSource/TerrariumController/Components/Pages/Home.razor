@page "/"
@implements IDisposable
@inject ISettingsService SettingsService
@inject ISensorService SensorService
@inject IRelayService RelayService
@inject IHumidityService HumidityService
@inject ICameraService CameraService

<section class="hero">
    <p class="eyebrow">Dashboard</p>
    <h2>Terrarium live control</h2>
    <p>Relays 1-3 follow temperature thresholds with 1 C hysteresis, Relay 4 follows daylight scheduling, and Relay 5 uses humidity pulse lockout from Sensor 1.</p>
    <p class="small-muted">Last refresh: @_lastRefreshLocal.ToString("yyyy-MM-dd HH:mm:ss")</p>
</section>

@if (_settings is null)
{
    <section class="panel"><p>Loading...</p></section>
}
else
{
    <section class="grid-3">
        <SensorRow
            Title="Nest 1 (Sensor 1 / Relay 1)"
            Sensor="@GetSensor(1)"
            RelayState="@GetRelay(1)"
            TemperatureThresholdC="@_settings.Sensor1TemperatureThresholdC"
            HumidityThresholdPercent="@_settings.Sensor1HumidityThresholdPercent"
            ShowHumidityThreshold="true"
            TemperatureThresholdChanged="@(value => _settings.Sensor1TemperatureThresholdC = value)"
            HumidityThresholdChanged="@(value => _settings.Sensor1HumidityThresholdPercent = value)" />

        <SensorRow
            Title="Nest 2 (Sensor 2 / Relay 2)"
            Sensor="@GetSensor(2)"
            RelayState="@GetRelay(2)"
            TemperatureThresholdC="@_settings.Sensor2TemperatureThresholdC"
            HumidityThresholdPercent="0"
            ShowHumidityThreshold="false"
            TemperatureThresholdChanged="@(value => _settings.Sensor2TemperatureThresholdC = value)" />

        <SensorRow
            Title="Arena (Sensor 3 / Relay 3)"
            Sensor="@GetSensor(3)"
            RelayState="@GetRelay(3)"
            TemperatureThresholdC="@_settings.Sensor3TemperatureThresholdC"
            HumidityThresholdPercent="0"
            ShowHumidityThreshold="false"
            TemperatureThresholdChanged="@(value => _settings.Sensor3TemperatureThresholdC = value)" />
    </section>

    <section class="grid">
        <DaylightScheduler
            DaylightOnMinutes="@_settings.DaylightOnMinutes"
            DaylightOffMinutes="@_settings.DaylightOffMinutes"
            RelayState="@GetRelay(4)"
            DaylightOnChanged="@(value => _settings.DaylightOnMinutes = value)"
            DaylightOffChanged="@(value => _settings.DaylightOffMinutes = value)" />

        <CameraFeed StreamUrl="@_cameraStreamUrl" />

        <article class="panel">
            <h3>Runtime</h3>
            <p class="small-muted">Relay 5 lockout until: @_lockoutUntilText</p>
            <p class="small-muted">Current Sensor 1 humidity: @GetSensor(1)?.HumidityPercent?.ToString("0.0") %</p>
            <button class="btn-primary" @onclick="SaveSettingsAsync">Save Control Settings</button>
            @if (!string.IsNullOrWhiteSpace(_statusMessage))
            {
                <p class="small-muted">@_statusMessage</p>
            }
        </article>
    </section>
}

@code {
    private TerrariumController.Models.Settings? _settings;
    private IReadOnlyList<LiveSensorState> _sensors = Array.Empty<LiveSensorState>();
    private IReadOnlyList<LiveRelayState> _relays = Array.Empty<LiveRelayState>();
    private string _cameraStreamUrl = string.Empty;
    private string _statusMessage = string.Empty;
    private string _lockoutUntilText = "not active";
    private DateTime _lastRefreshLocal = DateTime.Now;
    private PeriodicTimer? _timer;
    private CancellationTokenSource? _cts;

    protected override async Task OnInitializedAsync()
    {
        _settings = await SettingsService.GetAsync();
        _cameraStreamUrl = await CameraService.GetStreamUrlAsync();
        await RefreshAsync();

        _cts = new CancellationTokenSource();
        _timer = new PeriodicTimer(TimeSpan.FromSeconds(2));
        _ = Task.Run(() => RefreshLoopAsync(_cts.Token));
    }

    private async Task RefreshLoopAsync(CancellationToken cancellationToken)
    {
        while (!cancellationToken.IsCancellationRequested && _timer is not null)
        {
            try
            {
                if (!await _timer.WaitForNextTickAsync(cancellationToken))
                {
                    break;
                }

                await RefreshAsync();
                await InvokeAsync(StateHasChanged);
            }
            catch (OperationCanceledException)
            {
                break;
            }
        }
    }

    private async Task RefreshAsync()
    {
        _sensors = SensorService.GetLatest();
        _relays = RelayService.GetCurrentStates();
        _lastRefreshLocal = DateTime.Now;

        var lockoutState = await HumidityService.GetStateAsync();
        _lockoutUntilText = lockoutState.LockoutUntilUtc.HasValue
            ? lockoutState.LockoutUntilUtc.Value.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")
            : "not active";
    }

    private async Task SaveSettingsAsync()
    {
        if (_settings is null)
        {
            return;
        }

        await SettingsService.UpdateAsync(_settings);
        _cameraStreamUrl = await CameraService.GetStreamUrlAsync();
        _statusMessage = $"Saved at {DateTime.Now:HH:mm:ss}";
    }

    private LiveSensorState? GetSensor(int sensorId) => _sensors.FirstOrDefault(item => item.SensorId == sensorId);

    private LiveRelayState? GetRelay(int relayId) => _relays.FirstOrDefault(item => item.RelayId == relayId);

    public void Dispose()
    {
        _cts?.Cancel();
        _timer?.Dispose();
        _cts?.Dispose();
    }
}
