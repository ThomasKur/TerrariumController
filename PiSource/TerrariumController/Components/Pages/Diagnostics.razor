@page "/diagnostics"
@using TerrariumController.Services
@rendermode InteractiveServer
@implements IDisposable
@inject IControlDiagnosticsService DiagnosticsService
@inject IRelayCommandCoordinator RelayCommandCoordinator
@inject IRelayService RelayService
@inject IControlLoopSignal ControlLoopSignal
@inject ILogger<Diagnostics> Logger

<PageTitle>Control Diagnostics</PageTitle>

<div class="diagnostics-container">
    <div class="page-actions">
        <a href="/" class="back-link" aria-label="Back to home page">Back to Home</a>
    </div>

    <h1>Control Diagnostics</h1>

    <div class="summary-grid">
        <div class="summary-card">
            <div class="label">Snapshot (UTC)</div>
            <div class="value">@Snapshot.SnapshotUtc.ToString("yyyy-MM-dd HH:mm:ss")</div>
        </div>
        <div class="summary-card">
            <div class="label">Relay Queue Depth</div>
            <div class="value">@Snapshot.QueueDepth</div>
        </div>
        <div class="summary-card">
            <div class="label">Last Command Latency</div>
            <div class="value">@Snapshot.LastCommandLatencyMs.ToString("F1") ms</div>
        </div>
    </div>

    <section class="panel">
        <h2>Sensors</h2>
        <div class="status-legend" role="note" aria-label="Sensor status legend">
            <h3>Status Legend</h3>
            <ul>
                <li><span class="legend-chip legend-valid">valid</span> Current sensor read succeeded. Relay decisions use this reading.</li>
                <li><span class="legend-chip legend-invalid">invalid-preserve</span> Current read failed, but a recent valid read exists. Relay state is preserved.</li>
                <li><span class="legend-chip legend-failsafe">stale-failsafe</span> Current read failed and no recent valid read exists. Safety fallback forces relay OFF.</li>
            </ul>
        </div>
        <table>
            <thead>
                <tr>
                    <th>Sensor</th>
                    <th>Status</th>
                    <th>Timestamp (UTC)</th>
                    <th>Temp</th>
                    <th>Humidity</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var sensor in Snapshot.Sensors.Values.OrderBy(s => s.SensorId))
                {
                    <tr>
                        <td>@sensor.SensorId</td>
                        <td>@sensor.Status</td>
                        <td>@sensor.LastTimestampUtc.ToString("yyyy-MM-dd HH:mm:ss")</td>
                        <td>@(sensor.Temperature?.ToString("F1") ?? "--")</td>
                        <td>@(sensor.Humidity?.ToString("F0") ?? "--")</td>
                    </tr>
                }
            </tbody>
        </table>
    </section>

    <section class="panel">
        <h2>Relay Decisions</h2>
        <table>
            <thead>
                <tr>
                    <th>Relay</th>
                    <th>Target</th>
                    <th>Applied</th>
                    <th>Reason</th>
                    <th>Cycle</th>
                    <th>Timestamp (UTC)</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var relay in Snapshot.Relays.Values.OrderBy(r => r.RelayId))
                {
                    <tr>
                        <td>@relay.RelayId</td>
                        <td>@(relay.TargetState ? "ON" : "OFF")</td>
                        <td>@relay.Applied</td>
                        <td>@relay.Reason</td>
                        <td>@relay.CycleId</td>
                        <td>@relay.LastDecisionUtc.ToString("yyyy-MM-dd HH:mm:ss")</td>
                    </tr>
                }
            </tbody>
        </table>
    </section>

    <section class="panel">
        <h2>Manual Relay Overrides</h2>
        <p class="override-hint">Force any relay ON for 10 minutes, overriding scheduled and sensor-driven control. The control loop will restore the normal state after the override expires.</p>
        <table>
            <thead>
                <tr>
                    <th>Relay</th>
                    <th>Override Status</th>
                    <th>Expires (UTC)</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @for (int r = 1; r <= 6; r++)
                {
                    var relayId = r;
                    var expiry = GetOverrideExpiry(relayId);
                    <tr>
                        <td>Relay @relayId</td>
                        <td>
                            @if (expiry.HasValue)
                            {
                                <span class="override-chip override-active">Active (@FormatRemainingTime(expiry.Value))</span>
                            }
                            else
                            {
                                <span class="override-chip override-none">None</span>
                            }
                        </td>
                        <td>@(expiry.HasValue ? expiry.Value.ToString("HH:mm:ss") : "--")</td>
                        <td class="override-cell">
                            @if (expiry.HasValue)
                            {
                                <button class="diag-btn diag-btn-cancel" @onclick="() => CancelOverride(relayId)" aria-label="Cancel override for Relay @relayId">
                                    Cancel
                                </button>
                            }
                            else
                            {
                                <button class="diag-btn diag-btn-on" @onclick="() => ForceRelayOn(relayId)" aria-label="Force Relay @relayId on for 10 minutes">
                                    Force ON 10 min
                                </button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </section>
</div>

