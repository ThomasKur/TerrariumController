@code {
    private ControlDiagnosticsSnapshot Snapshot = new(DateTime.UtcNow, new Dictionary<int, SensorDiagnostic>(), new Dictionary<int, RelayDecisionDiagnostic>(), 0, 0);
    private IReadOnlyDictionary<int, DateTime> ActiveOverrides = new Dictionary<int, DateTime>();
    private PeriodicTimer? _timer;
    private CancellationTokenSource? _cts;

    protected override Task OnInitializedAsync()
    {
        Refresh();
        _cts = new CancellationTokenSource();
        _timer = new PeriodicTimer(TimeSpan.FromSeconds(2));
        _ = Task.Run(() => RunRefreshLoopAsync(_cts.Token));
        return Task.CompletedTask;
    }

    private async Task RunRefreshLoopAsync(CancellationToken cancellationToken)
    {
        if (_timer == null)
        {
            return;
        }

        try
        {
            while (await _timer.WaitForNextTickAsync(cancellationToken))
            {
                await InvokeAsync(() =>
                {
                    Refresh();
                    StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    private void Refresh()
    {
        Snapshot = DiagnosticsService.GetSnapshot();
        ActiveOverrides = RelayCommandCoordinator.GetActiveOverrides();
    }

    private DateTime? GetOverrideExpiry(int relayId)
    {
        return ActiveOverrides.TryGetValue(relayId, out var expiry) ? expiry : null;
    }

    private static string FormatRemainingTime(DateTime expiresAtUtc)
    {
        var remaining = expiresAtUtc - DateTime.UtcNow;
        if (remaining <= TimeSpan.Zero)
            return "expiring";
        return remaining.TotalSeconds < 60
            ? $"{(int)remaining.TotalSeconds}s"
            : $"{(int)remaining.TotalMinutes}m {remaining.Seconds:D2}s";
    }

    private async Task ForceRelayOn(int relayId)
    {
        try
        {
            await RelayCommandCoordinator.RequestRelayStateAsync(relayId, true, "Manual Override");
            ActiveOverrides = RelayCommandCoordinator.GetActiveOverrides();
            ControlLoopSignal.RequestImmediateEvaluation($"Manual Override Relay {relayId}");
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to apply manual override for Relay {RelayId}", relayId);
        }
    }

    private void CancelOverride(int relayId)
    {
        try
        {
            RelayCommandCoordinator.CancelOverride(relayId);
            ActiveOverrides = RelayCommandCoordinator.GetActiveOverrides();
            ControlLoopSignal.RequestImmediateEvaluation($"Manual Override Cancelled Relay {relayId}");
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to cancel manual override for Relay {RelayId}", relayId);
        }
    }

    public void Dispose()
    {
        _cts?.Cancel();
        _timer?.Dispose();
        _cts?.Dispose();
    }
}
