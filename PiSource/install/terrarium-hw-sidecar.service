[Unit]
Description=Terrarium Hardware Sidecar Service
After=network.target

[Service]
Type=simple
User=terrarium
Group=terrarium
WorkingDirectory=/opt/terrarium-hw-sidecar
EnvironmentFile=-/etc/terrarium/terrarium.env
ExecStart=/bin/bash /opt/terrarium-hw-sidecar/run-sidecar.sh
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
