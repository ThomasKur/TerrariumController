[Unit]
Description=Terrarium Controller Service
After=network.target
Wants=terrarium-camera.service
Wants=terrarium-hw-sidecar.service
StartLimitIntervalSec=0

[Service]
Type=simple
Restart=on-failure
RestartSec=10
User=terrarium
WorkingDirectory=/opt/terrarium
EnvironmentFile=-/etc/terrarium/terrarium.env
ExecStart=/opt/terrarium/run.sh
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
