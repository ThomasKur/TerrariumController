[Unit]
Description=Terrarium Controller
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=/opt/terrarium
ExecStart=/usr/bin/dotnet /opt/terrarium/TerrariumController.dll
Restart=always
RestartSec=5
User=pi
Environment=ASPNETCORE_URLS=http://0.0.0.0:5000
Environment=DOTNET_ENVIRONMENT=Production

[Install]
WantedBy=multi-user.target